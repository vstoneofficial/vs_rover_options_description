<?xml version="1.0"?>
<robot name="lrf_tg30_x40a" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="lidar" default="true" />
  <xacro:property name="tg30_enabled" value="true" />

  <xacro:arg name="front_laser_visual" default="false" />
  <xacro:arg name="back_laser_visual" default="false" />

  <xacro:property name="DEG_TO_RAD" value="0.01745329251994329577" />
  <xacro:property name="LRF_ANGLE" value="172" />

  <gazebo reference="front_lrf_link">
    <selfCollide>true</selfCollide>
    <xacro:if value="$(arg lidar)">
    <sensor name="tg30_lidar_front" type="gpu_lidar">
        <topic>/scan</topic>
        <gz_frame_id>front_lrf_link</gz_frame_id>
        <always_on>true</always_on>
        <visualize>$(arg front_laser_visual)</visualize>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>${-LRF_ANGLE*DEG_TO_RAD}</min_angle>
              <max_angle>${ LRF_ANGLE*DEG_TO_RAD}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </xacro:if>
  </gazebo>

  <gazebo reference="back_lrf_link">
    <selfCollide>true</selfCollide>
    <xacro:if value="$(arg lidar)">
    <sensor name="tg30_lidar_back" type="gpu_lidar">
        <topic>/back_scan</topic>
        <gz_frame_id>back_lrf_link</gz_frame_id>
        <always_on>true</always_on>
        <visualize>$(arg back_laser_visual)</visualize>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>${-LRF_ANGLE*DEG_TO_RAD}</min_angle>
              <max_angle>${ LRF_ANGLE*DEG_TO_RAD}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </xacro:if>
  </gazebo>
  
</robot>
