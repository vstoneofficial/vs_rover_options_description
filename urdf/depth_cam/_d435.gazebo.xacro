This is the Gazebo URDF model for the Intel RealSense D435 camera
-->

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="gazebo_d435" params="camera_name reference_link topics_ns depth_optical_frame color_optical_frame infrared1_optical_frame infrared2_optical_frame publish_pointcloud:=true">

    <!-- Load parameters to model's main link-->
    <xacro:property name="deg_to_rad" value="0.01745329251994329577" />

    <gazebo reference="${reference_link}">
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
      <!--<mu>1</mu>-->
      <mu2>1</mu2>
      <fdir1>0 0 0</fdir1>
      <!--<slip1>0</slip1>
      <slip2>0</slip2>-->
      <kp>1e+13</kp>
      <kd>1</kd>
      <!--<max_vel>0.01</max_vel>
      <min_depth>0</min_depth>-->
      <xacro:if value="${publish_pointcloud}">
        <sensor name="${camera_name}depth" type="rgbd_camera">
        <topic>/${topics_ns}/depth</topic>
        <!-- Native RGBD XYZ uses the carrier's forward-X axes; images use optical axes. -->
        <gz_frame_id>${reference_link}</gz_frame_id>
        <camera name="${camera_name}">
          <camera_info_topic>/${topics_ns}/depth/camera_info</camera_info_topic>
          <optical_frame_id>${depth_optical_frame}</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
          <depth_camera>
            <clip><near>0.3</near><far>3.0</far></clip>
          </depth_camera>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>
      </xacro:if>
      <xacro:unless value="${publish_pointcloud}">
        <sensor name="${camera_name}depth" type="depth_camera">
        <topic>/${topics_ns}/depth/image_raw</topic>
        <gz_frame_id>${depth_optical_frame}</gz_frame_id>
        <camera name="${camera_name}">
          <camera_info_topic>/${topics_ns}/depth/camera_info</camera_info_topic>
          <optical_frame_id>${depth_optical_frame}</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.100</stddev>
          </noise>
          <depth_camera>
            <clip><near>0.3</near><far>3.0</far></clip>
          </depth_camera>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>
      </xacro:unless>
      <sensor name="${camera_name}color" type="camera">
        <topic>/${topics_ns}/color/image_raw</topic>
        <gz_frame_id>${color_optical_frame}</gz_frame_id>
        <camera name="${camera_name}">
          <camera_info_topic>/${topics_ns}/color/camera_info</camera_info_topic>
          <optical_frame_id>${color_optical_frame}</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
      </sensor>
      <sensor name="${camera_name}ired1" type="camera">
        <topic>/${topics_ns}/infra1/image_raw</topic>
        <gz_frame_id>${infrared1_optical_frame}</gz_frame_id>
        <camera name="${camera_name}">
          <camera_info_topic>/${topics_ns}/infra1/camera_info</camera_info_topic>
          <optical_frame_id>${infrared1_optical_frame}</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>0</visualize>
      </sensor>
      <sensor name="${camera_name}ired2" type="camera">
        <topic>/${topics_ns}/infra2/image_raw</topic>
        <gz_frame_id>${infrared2_optical_frame}</gz_frame_id>
        <camera name="${camera_name}">
          <camera_info_topic>/${topics_ns}/infra2/camera_info</camera_info_topic>
          <optical_frame_id>${infrared2_optical_frame}</optical_frame_id>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.05</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <visualize>0</visualize>
      </sensor>
    </gazebo>


  </xacro:macro>
</robot>
