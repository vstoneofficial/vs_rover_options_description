<?xml version="1.0"?>
<robot name="40バンパー" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- A direct include keeps the default names and zero mounting transform.
       A product mounting macro may set these properties in its local scope. -->
  <xacro:property name="bumper40_prefix" default="" />
  <xacro:property name="bumper40_parent" default="base_link" />
  <xacro:property name="bumper40_xyz" default="0.0 0.0 0.0" />
  <xacro:property name="bumper40_rpy" default="0.0 0.0 0.0" />
  <material name="${bumper40_prefix}material_bumper_link_Center">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <material name="${bumper40_prefix}material_bumper_link_left">
