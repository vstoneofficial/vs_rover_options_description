  <joint name="${bumper40_prefix}bumper_mount_joint" type="fixed">
    <origin xyz="${bumper40_xyz}" rpy="${bumper40_rpy}" />
    <parent link="${bumper40_parent}" />
    <child link="${bumper40_prefix}bumper_plate" />
  </joint>
  <joint name="${bumper40_prefix}bumper_right_joint" type="prismatic">
    <origin xyz="0.058472 0.048506 0.01375" rpy="0.0 0.0 0.0" />
    <parent link="${bumper40_prefix}bumper_plate" />
    <child link="${bumper40_prefix}bumper_link_right" />
    <axis xyz="0.438371 0.898794 -0.0" />
    <limit effort="100.0" velocity="100.0" upper="0.0" lower="-0.002" />
  </joint>
  <joint name="${bumper40_prefix}bumper_center_joint" type="prismatic">
    <origin xyz="0.052 0.047985 0.01375" rpy="0.0 0.0 0.0" />
    <parent link="${bumper40_prefix}bumper_plate" />
    <child link="${bumper40_prefix}bumper_link_Center" />
    <axis xyz="-0.0 1.0 0.0" />
    <limit effort="100.0" velocity="100.0" upper="0.0" lower="-0.002" />
  </joint>
  <joint name="${bumper40_prefix}bumper_left_joint" type="prismatic">
    <origin xyz="-0.057588 0.046695 0.01225" rpy="0.0 0.0 0.0" />
    <parent link="${bumper40_prefix}bumper_plate" />
    <child link="${bumper40_prefix}bumper_link_left" />
    <axis xyz="-0.438371 0.898794 0.0" />
    <limit effort="100.0" velocity="100.0" upper="0.0" lower="-0.002" />
  </joint>
  <!-- Each slider has two parallel MISUMI WT8-15 springs (2 N/mm each).
       Free length: 15 mm; installed length at q=0: 10 mm; preload: 20 N total.
       Equivalent stiffness: 4000 N/m; the unloaded reference is q=+0.005 m.
       Negative q compresses the springs further. Existing travel remains -0.002 to 0 m.
       At q=-0.002 m, each spring is compressed 7 mm and carries 14 N (calculated),
       exceeding the supplied 40% deflection (6 mm) and 11.8 N load ratings.
       No unprovided damping, friction, mass, or coil geometry is assumed. -->
  <gazebo reference="${bumper40_prefix}bumper_right_joint">
    <springReference>0.005</springReference>
    <springStiffness>4000.0</springStiffness>
  </gazebo>
  <gazebo reference="${bumper40_prefix}bumper_center_joint">
    <springReference>0.005</springReference>
    <springStiffness>4000.0</springStiffness>
  </gazebo>
  <gazebo reference="${bumper40_prefix}bumper_left_joint">
    <springReference>0.005</springReference>
    <springStiffness>4000.0</springStiffness>
  </gazebo>
</robot>
