      <mass value="0.017300984468806884" />
      <inertia ixx="4.142384817976052e-06" iyy="1.3008176497921267e-05" izz="1.4881946334589612e-05" ixy="-5.673847936756567e-06" iyz="1.4823076576950256e-21" ixz="5.929230630780102e-21" />
    </inertial>
    <visual>
