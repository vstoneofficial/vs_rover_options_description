  <link name="${bumper40_prefix}bumper_link_Center">
    <inertial>
      <origin xyz="-0.05199999999999989 -0.00018912099341653749 -0.010499999999999985" rpy="0 0 0" />
      <mass value="0.01730098446880679" />
      <inertia ixx="1.3750642766526238e-06" iyy="1.5775497039247394e-05" izz="1.4881946334592315e-05" ixy="2.4366610587125352e-20" iyz="8.470329472543003e-22" ixz="1.9518608951329977e-20" />
    </inertial>
    <visual>
      <origin xyz="-0.052 -0.047985 -0.01375" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/40_bumper_link.stl" scale="0.001 0.001 0.001" />
