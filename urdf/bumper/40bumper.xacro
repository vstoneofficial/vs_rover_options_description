      <inertia ixx="4.142384817977016e-06" iyy="1.3008176497925278e-05" izz="1.4881946334594653e-05" ixy="5.6738479367585595e-06" iyz="-6.1409888675936775e-21" ixz="-2.541098841762901e-20" />
    </inertial>
    <visual>
