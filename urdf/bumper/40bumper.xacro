  </material>
  <material name="${bumper40_prefix}material_bumper_link_right">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <material name="${bumper40_prefix}material_bumper_plate">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <link name="${bumper40_prefix}bumper_plate">
