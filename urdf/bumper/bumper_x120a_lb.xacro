  <!-- Each frame carries one reusable 120 mm bumper with three passive spring sliders. -->
  <xacro:macro name="x120a_lb_bumper_mount" params="prefix parent xyz rpy">
    <xacro:property name="bumper120_prefix" value="${prefix}_" />
    <xacro:property name="bumper120_parent" value="${parent}" />
    <xacro:property name="bumper120_xyz" value="${xyz}" />
    <xacro:property name="bumper120_rpy" value="${rpy}" />
    <xacro:include filename="$(find vs_rover_options_description)/urdf/bumper/120bumper.xacro" />
  </xacro:macro>
  <xacro:x120a_lb_bumper_mount prefix="front" parent="front_bumper_frame" xyz="0.073481392010866009 2.3286461894299146e-14 0.0075000000000000136" rpy="0 0 -1.5707963267948966" />
