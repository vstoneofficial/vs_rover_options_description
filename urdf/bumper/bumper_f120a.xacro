<robot name="bumper_f120a" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="bumper_aluminum_frame_1">
    <visual>
      <geometry>
        <box size="0.02 0.545 0.02" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>

  <link name="bumper_aluminum_frame_2">
    <visual>
      <geometry>
        <box size="0.02 0.545 0.02" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>

  <xacro:property name="bumper_alu_frame_x_offset" value="0.105" />
  <xacro:property name="bumper_alu_frame_y_offset" value="-0.0275" />
  <xacro:property name="bumper_alu_frame_z_offset" value="0.0485" />

  <joint name="bumper_aluminum_frame_fixed_joint_1" type="fixed">
    <origin xyz="${bumper_alu_frame_y_offset} ${-bumper_alu_frame_x_offset} ${bumper_alu_frame_z_offset}" rpy="0 0 -1.5708" />
    <parent link="base_link" />
    <child link="bumper_aluminum_frame_1" />
  </joint>

  <joint name="bumper_aluminum_frame_fixed_joint_2" type="fixed">
    <origin xyz="${bumper_alu_frame_y_offset} ${bumper_alu_frame_x_offset} ${bumper_alu_frame_z_offset}" rpy="0 0 -1.5708" />
    <parent link="base_link" />
    <child link="bumper_aluminum_frame_2" />
  </joint>

  <!-- F120A mounting of the reusable, passive spring-loaded 120 mm bumper. -->
  <xacro:macro name="bumperbaseboard" params="prefix parent xyz z_dir">
    <xacro:property name="bumper120_prefix" value="${prefix}_" />
    <xacro:property name="bumper120_parent" value="${parent}" />
    <xacro:property name="bumper120_xyz" value="${xyz}" />
    <!-- The former mesh used a -pi rotation; the common model faces local +Y. -->
    <xacro:property name="bumper120_rpy" value="0 0 ${radians(z_dir) - pi}" />
    <xacro:include filename="$(find vs_rover_options_description)/urdf/bumper/120bumper.xacro" />
  </xacro:macro>

</robot>
