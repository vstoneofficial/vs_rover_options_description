<?xml version="1.0"?>
<robot name="120バンパー" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- A direct include keeps the default names and zero mounting transform.
       A product mounting macro may set these properties in its local scope. -->
  <xacro:property name="bumper120_prefix" default="" />
  <xacro:property name="bumper120_parent" default="base_link" />
  <xacro:property name="bumper120_xyz" default="0.0 0.0 0.0" />
  <xacro:property name="bumper120_rpy" default="0.0 0.0 0.0" />
  <material name="${bumper120_prefix}material_bumper_link_Center">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <material name="${bumper120_prefix}material_bumper_link_left">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <material name="${bumper120_prefix}material_bumper_link_right">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <material name="${bumper120_prefix}material_bumper_plate">
    <color rgba="0.956863 0.960784 0.964706 1.000000" />
  </material>
  <link name="${bumper120_prefix}bumper_plate">
    <inertial>
      <origin xyz="-8.73397128808636e-16 0.011426605963771728 0.0021044902370477682" rpy="0 0 0" />
      <mass value="0.6488527726759663" />
      <inertia ixx="0.0001871062012874279" iyy="0.006269580866309916" izz="0.006431702660715098" ixy="-1.9637735182210388e-17" iyz="-5.994596665523142e-06" ixz="1.2143501710811834e-18" />
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_plate.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="${bumper120_prefix}material_bumper_plate" />
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_plate.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="${bumper120_prefix}bumper_link_right">
    <inertial>
      <origin xyz="-0.044313089868094846 0.00982150716085796 0.0" rpy="0 0 0" />
      <mass value="0.026599494203624348" />
      <inertia ixx="6.808036082717834e-06" iyy="3.487918468356047e-05" izz="3.8212073693750246e-05" ixy="1.1777245218846123e-05" iyz="-3.6845933205562065e-20" ixz="-2.202285662861181e-20" />
    </inertial>
    <visual>
      <origin xyz="-0.059386949835983721 -0.031593582724935336 -0.0024999999999999927" rpy="0 0 -0.3490658503988659" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="${bumper120_prefix}material_bumper_link_right" />
    </visual>
    <collision>
      <origin xyz="-0.059386949835983721 -0.031593582724935336 -0.0024999999999999927" rpy="0 0 -0.3490658503988659" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="${bumper120_prefix}bumper_link_Center">
    <inertial>
      <origin xyz="-0.04499999999999918 -0.005926981898446523 -7.37257477290143e-18" rpy="0 0 0" />
      <mass value="0.026599494203624292" />
      <inertia ixx="2.521469381403352e-06" iyy="3.916575138487429e-05" izz="3.821207369374971e-05" ixy="-6.392124231619639e-20" iyz="1.6940658945086007e-21" ixz="9.52127265918371e-22" />
    </inertial>
    <visual>
      <origin xyz="-0.045 -0.05 -0.0025" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="${bumper120_prefix}material_bumper_link_Center" />
    </visual>
    <collision>
      <origin xyz="-0.045 -0.05 -0.0025" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="${bumper120_prefix}bumper_link_left">
    <inertial>
      <origin xyz="-0.04025891013190386 -0.020960492839141594 -5.204170427930421e-18" rpy="0 0 0" />
      <mass value="0.02659949420362442" />
      <inertia ixx="6.8080360827178495e-06" iyy="3.4879184683560196e-05" izz="3.821207369375003e-05" ixy="-1.1777245218846286e-05" iyz="3.1763735522036263e-21" ixz="-1.8634724839594607e-20" />
    </inertial>
    <visual>
      <origin xyz="-0.025185050164016509 -0.062375582724935444 -0.0024999999999999979" rpy="0 0 0.3490658503988659" />
      <geometry>
        <mesh filename="package://vs_rover_options_description/meshes/bumper/120_bumper_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="${bumper120_prefix}material_bumper_link_left" />
