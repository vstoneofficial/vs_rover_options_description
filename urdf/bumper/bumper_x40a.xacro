<robot name="bumper_x40a" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="bumper_aluminum_frame_1">
    <visual>
      <geometry>
        <box size="0.12 0.4243 0.005" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>

  <link name="bumper_aluminum_frame_2">
    <visual>
      <geometry>
        <box size="0.12 0.4243 0.005" />
      </geometry>
      <material name="silver" />
    </visual>
  </link>

  <xacro:property name="bumper_alu_frame_x_offset" value="0" />
  <xacro:property name="bumper_alu_frame_z_offset" value="0.03" />

  <joint name="bumper_aluminum_frame_fixed_joint_1" type="fixed">
    <origin xyz="0.0 ${-bumper_alu_frame_x_offset} ${bumper_alu_frame_z_offset}" rpy="0 0 ${-pi/2}" />
    <parent link="base_link" />
    <child link="bumper_aluminum_frame_1" />
  </joint>

  <joint name="bumper_aluminum_frame_fixed_joint_2" type="fixed">
    <origin xyz="0.0 ${bumper_alu_frame_x_offset} ${bumper_alu_frame_z_offset}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="bumper_aluminum_frame_2" />
  </joint>

  <!-- X40A mounting of the reusable, passive spring-loaded 40 mm bumper. -->
  <xacro:macro name="bumperbaseboard" params="prefix parent xyz z_dir">
    <xacro:property name="bumper40_prefix" value="${prefix}_" />
    <xacro:property name="bumper40_parent" value="${parent}" />
    <xacro:property name="bumper40_xyz" value="${xyz}" />
    <!-- The former mesh used a -pi rotation; the common model faces local +Y. -->
    <xacro:property name="bumper40_rpy" value="0 0 ${radians(z_dir) - pi}" />
    <xacro:include filename="$(find vs_rover_options_description)/urdf/bumper/40bumper.xacro" />
  </xacro:macro>


  <!-- Complete product layout: including this file places all bumper assemblies. -->
  <xacro:bumperbaseboard prefix="front" parent="base_link" xyz="0.20515 0 0.038" z_dir="90" />
  <xacro:bumperbaseboard prefix="back" parent="base_link" xyz="-0.20515 0 0.038" z_dir="-90" />
  <xacro:bumperbaseboard prefix="right" parent="base_link" xyz="0 -0.20515 0.038" z_dir="0" />
  <xacro:bumperbaseboard prefix="left" parent="base_link" xyz="0 0.20515 0.038" z_dir="180" />

</robot>
